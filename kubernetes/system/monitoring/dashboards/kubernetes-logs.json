{
  "title": "Kubernetes Logs",
  "uid": "k8s-logs-v1",
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": "label_values(namespace)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "label": "Namespace"
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": "label_values({namespace=\"$namespace\"}, pod)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "label": "Pod"
      },
      {
        "name": "container",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": "label_values({namespace=\"$namespace\", pod=\"$pod\"}, container)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "label": "Container"
      }
    ]
  },
  "panels": [
    {
      "type": "logs",
      "title": "Logs",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 25 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "dedupStrategy": "none",
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{namespace=~\"$namespace\", pod=~\"$pod\", container=~\"$container\"}",
          "refId": "A"
        }
      ]
    }
  ],
  "__inputs": [
    {
      "name": "DS_LOKI",
      "type": "datasource",
      "pluginId": "loki",
      "label": "Loki"
    }
  ],
  "schemaVersion": 38
}
